# --- Wasender (only when integrations.whatsapp.provider === "wasender") ---
# The API key is the per-session token from the Wasender dashboard
# (Session → Credentials → API Access Token). It IS the session
# credential — Wasender has no separate session-id concept.
WASENDER_API_KEY=
WASENDER_BASE_URL=https://www.wasenderapi.com/api
